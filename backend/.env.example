# Backend server
PORT=4000

# MySQL connection
DB_HOST=localhost
# MySQL port. Defaults to 3306 when omitted.
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=attendance_system_db

# JWT signing secret.
# Set this to a long, random value in your local .env file.
# Minimum length: 32 characters.
JWT_SECRET=

# First administrator seed values.
# These are read only by `npm run db:seed-admin`.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
